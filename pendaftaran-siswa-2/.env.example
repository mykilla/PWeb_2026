# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env ke GitHub.
APP_ENV=local            # local | production
APP_NAME="SMK Coding"
APP_URL=                 # kosongkan agar dideteksi otomatis, contoh: https://psb.sekolah.sch.id

DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_pendaftaran
DB_USER=root
DB_PASS=

# Aturan bisnis
MIN_USIA=12
MAX_USIA=21
SESSION_IDLE_MINUTES=30

# Payment gateway: mock (simulasi lokal) | midtrans
PAYMENT_DRIVER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Isi 1 hanya jika aplikasi berada di belakang reverse proxy tepercaya
TRUST_PROXY=0
